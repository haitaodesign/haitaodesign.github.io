.html {
    <div class="container fullwidth pagination-container">
        <div style="display: flex; gap: 16px; width: 100%;">
}
.if {.prevlink::isnotempty}
    .html {
        <a href="} .prevlink .html {" class="pagination-card prev-card">
            <span class="prev-label">← 上一章</span>
            <span class="pagination-title">} .prevtitle .html {</span>
        </a>
    }
.if {.nextlink::isnotempty}
    .html {
        <a href="} .nextlink .html {" class="pagination-card next-card">
            <span class="next-label">下一章 →</span>
            <span class="pagination-title">} .nexttitle .html {</span>
        </a>
    }
.html {
        </div>
    </div>
}
